<?xml version="1.0" encoding="utf-8"?>
<!-- Chat bubble (practical #8): assistant left/white card, user right/green -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/bubble_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="6dp"
    android:layout_marginBottom="12dp">

    <TextView
        android:id="@+id/bubble_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="300dp"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:background="@drawable/bg_bubble_ai"
        android:textSize="14sp"
        android:lineHeight="20sp"
        android:fontFamily="@font/inter"
        android:textColor="@color/rowin_on_surface"
        tools:text="How can I help with your closet today?" />
</FrameLayout>
