<?xml version="1.0" encoding="utf-8"?>
<!-- Overlapping avatar dot on the Home hero card: 40dp circle + 2dp ring -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/hero_avatar_root"
    android:layout_width="40dp"
    android:layout_height="40dp">

    <ImageView
        android:id="@+id/hero_avatar_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:background="@drawable/bg_circle_container"
        android:contentDescription="@string/none"
        tools:src="@drawable/ic_image" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_hero_ring" />
</FrameLayout>
