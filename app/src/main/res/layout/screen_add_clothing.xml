<?xml version="1.0" encoding="utf-8"?>
<!--
    Add / Edit Clothing (features #5-#7, #20) - 1:1 with the Stitch
    add_clothing design: header (close + ROWIN wordmark), 4:5 image area with
    Camera / Gallery pills, the "Analyze with AI" panel, Item Details form
    and the fixed "Add to Closet" bottom bar.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/add_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/rowin_surface">

    <!-- Header: close + centered ROWIN + spacer (per mock) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <ImageButton
            android:id="@+id/add_close"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_close"
            android:contentDescription="@string/close"
            tools:tint="@color/rowin_on_surface" />

        <ImageView
            android:layout_width="0dp"
            android:layout_height="16dp"
            android:layout_weight="1"
            android:adjustViewBounds="true"
            android:contentDescription="@string/app_name"
            android:src="@drawable/wordmark_rowin" />

        <Space
            android:layout_width="48dp"
            android:layout_height="1dp" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/add_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">

            <TextView
                android:id="@+id/add_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/add_clothing_title"
                android:textSize="24sp"
                android:lineHeight="32sp"
                android:letterSpacing="-0.01"
                android:fontFamily="@font/manrope"
                android:textStyle="bold"
                android:textColor="@color/rowin_on_surface" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="16dp"
                android:text="@string/add_clothing_sub"
                android:textSize="14sp"
                android:lineHeight="20sp"
                android:fontFamily="@font/inter"
                android:textColor="@color/rowin_on_surface_variant" />

            <!-- Image area with Camera / Gallery pills -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/add_image_area"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_image_slot"
                xmlns:app="http://schemas.android.com/apk/res-auto">

                <ImageView
                    android:id="@+id/add_image"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:scaleType="centerCrop"
                    android:contentDescription="@string/clothing_photo"
                    app:layout_constraintDimensionRatio="4:5"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <ImageView
                    android:id="@+id/add_image_placeholder"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:src="@drawable/ic_image"
                    android:tint="@color/rowin_outline"
                    android:contentDescription="@string/none"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingBottom="20dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                    <LinearLayout
                        android:id="@+id/add_camera_chip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:paddingTop="10dp"
                        android:paddingBottom="10dp"
                        android:background="@drawable/bg_media_chip">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_photo_camera"
                            android:tint="@color/rowin_on_surface"
                            android:contentDescription="@string/none" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="@string/camera"
                            android:textSize="12sp"
                            android:lineHeight="16sp"
                            android:letterSpacing="0.04"
                            android:fontFamily="@font/inter_medium"
                            android:textColor="@color/rowin_on_surface" />
                    </LinearLayout>

                    <Space
                        android:layout_width="12dp"
                        android:layout_height="1dp" />

                    <LinearLayout
                        android:id="@+id/add_gallery_chip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:paddingTop="10dp"
                        android:paddingBottom="10dp"
                        android:background="@drawable/bg_media_chip">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_photo_library"
                            android:tint="@color/rowin_on_surface"
                            android:contentDescription="@string/none" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="@string/gallery"
                            android:textSize="12sp"
                            android:lineHeight="16sp"
                            android:letterSpacing="0.04"
                            android:fontFamily="@font/inter_medium"
                            android:textColor="@color/rowin_on_surface" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- AI analysis panel (feature #6) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="@drawable/bg_ai_panel">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <FrameLayout
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_ai_icon_box">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_auto_awesome"
                            android:tint="@color/rowin_on_primary"
                            android:contentDescription="@string/none" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="2dp"
                        android:text="@string/analyze_with_ai"
                        android:textSize="14sp"
                        android:lineHeight="20sp"
                        android:letterSpacing="0.01"
                        android:fontFamily="@font/inter_medium"
                        android:textColor="@color/rowin_primary" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="12dp"
                    android:text="@string/analyze_desc"
                    android:textSize="13sp"
                    android:lineHeight="18sp"
                    android:fontFamily="@font/inter"
                    android:textColor="@color/rowin_on_surface_variant" />

                <TextView
                    android:id="@+id/add_ai_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    android:textSize="13sp"
                    android:lineHeight="18sp"
                    android:fontFamily="@font/inter"
                    android:textColor="@color/rowin_on_surface_variant" />

                <Button
                    android:id="@+id/add_ai_apply"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="8dp"
                    android:visibility="gone"
                    android:background="@drawable/bg_button_primary"
                    android:stateListAnimator="@null"
                    android:text="@string/apply_to_fields"
                    android:textSize="14sp"
                    android:letterSpacing="0.01"
                    android:fontFamily="@font/inter_medium"
                    android:textColor="@color/rowin_on_primary" />

                <Button
                    android:id="@+id/add_ai_analyze"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_button_outlined"
                    android:stateListAnimator="@null"
        android:text="@string/analyze_with_ai_action"
        android:textSize="14sp"
        android:letterSpacing="0.01"
        android:fontFamily="@font/inter_medium"
        android:textColor="@color/rowin_on_surface" />
            </LinearLayout>

            <!-- Item details form -->
            <Space
                android:layout_width="match_parent"
                android:layout_height="24dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/item_details"
                android:textSize="20sp"
                android:lineHeight="26sp"
                android:fontFamily="@font/manrope"
                android:textStyle="bold"
                android:textColor="@color/rowin_on_surface" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="16dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginBottom="6dp"
                android:text="@string/field_name"
                android:textSize="12sp"
                android:lineHeight="16sp"
                android:letterSpacing="0.04"
                android:fontFamily="@font/inter_medium"
                android:textColor="@color/rowin_on_surface_variant" />

            <EditText
                android:id="@+id/add_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="56dp"
                android:background="@drawable/bg_field"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:hint="@string/hint_item_name"
                android:textColorHint="@color/rowin_outline"
                android:textSize="14sp"
                android:fontFamily="@font/inter"
                android:textColor="@color/rowin_on_surface"
                android:inputType="text"
                android:singleLine="true" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="16dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginBottom="6dp"
                android:text="@string/field_category"
                android:textSize="12sp"
                android:lineHeight="16sp"
                android:letterSpacing="0.04"
                android:fontFamily="@font/inter_medium"
                android:textColor="@color/rowin_on_surface_variant" />

            <LinearLayout
                android:id="@+id/add_category_root"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:minHeight="56dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:background="@drawable/bg_dropdown"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:id="@+id/add_category_value"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textSize="14sp"
                    android:fontFamily="@font/inter"
                    android:textColor="@color/rowin_on_surface"
                    tools:text="Tops" />

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_arrow_drop_down"
                    android:tint="@color/rowin_on_surface_variant"
                    android:contentDescription="@string/none" />
            </LinearLayout>

            <Space
                android:layout_width="match_parent"
                android:layout_height="16dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginBottom="6dp"
                android:text="@string/field_color"
                android:textSize="12sp"
                android:lineHeight="16sp"
                android:letterSpacing="0.04"
                android:fontFamily="@font/inter_medium"
                android:textColor="@color/rowin_on_surface_variant" />

            <EditText
                android:id="@+id/add_color"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="56dp"
                android:background="@drawable/bg_field"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:hint="@string/hint_color"
                android:textColorHint="@color/rowin_outline"
                android:textSize="14sp"
                android:fontFamily="@font/inter"
                android:textColor="@color/rowin_on_surface"
                android:inputType="text"
                android:singleLine="true" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="16dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:layout_marginBottom="6dp"
                        android:text="@string/field_season"
                        android:textSize="12sp"
                        android:lineHeight="16sp"
                        android:letterSpacing="0.04"
                        android:fontFamily="@font/inter_medium"
                        android:textColor="@color/rowin_on_surface_variant" />

                    <LinearLayout
                        android:id="@+id/add_season_root"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:minHeight="56dp"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:background="@drawable/bg_dropdown"
                        android:clickable="true"
                        android:focusable="true">

                        <TextView
                            android:id="@+id/add_season_value"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textSize="14sp"
                            android:fontFamily="@font/inter"
                            android:textColor="@color/rowin_on_surface"
                            tools:text="All Season" />

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_arrow_drop_down"
                            android:tint="@color/rowin_on_surface_variant"
                            android:contentDescription="@string/none" />
                    </LinearLayout>
                </LinearLayout>

                <Space
                    android:layout_width="16dp"
                    android:layout_height="1dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:layout_marginBottom="6dp"
                        android:text="@string/field_occasion"
                        android:textSize="12sp"
                        android:lineHeight="16sp"
                        android:letterSpacing="0.04"
                        android:fontFamily="@font/inter_medium"
                        android:textColor="@color/rowin_on_surface_variant" />

                    <LinearLayout
                        android:id="@+id/add_occasion_root"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:minHeight="56dp"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:background="@drawable/bg_dropdown"
                        android:clickable="true"
                        android:focusable="true">

                        <TextView
                            android:id="@+id/add_occasion_value"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textSize="14sp"
                            android:fontFamily="@font/inter"
                            android:textColor="@color/rowin_on_surface"
                            tools:text="Casual" />

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_arrow_drop_down"
                            android:tint="@color/rowin_on_surface_variant"
                            android:contentDescription="@string/none" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <Space
                android:layout_width="match_parent"
                android:layout_height="16dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:layout_marginBottom="6dp"
                        android:text="@string/field_pattern"
                        android:textSize="12sp"
                        android:lineHeight="16sp"
                        android:letterSpacing="0.04"
                        android:fontFamily="@font/inter_medium"
                        android:textColor="@color/rowin_on_surface_variant" />

                    <EditText
                        android:id="@+id/add_pattern"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="56dp"
                        android:background="@drawable/bg_field"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:hint="@string/hint_pattern"
                        android:textColorHint="@color/rowin_outline"
                        android:textSize="14sp"
                        android:fontFamily="@font/inter"
                        android:textColor="@color/rowin_on_surface"
                        android:inputType="text"
                        android:singleLine="true" />
                </LinearLayout>

                <Space
                    android:layout_width="16dp"
                    android:layout_height="1dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:layout_marginBottom="6dp"
                        android:text="@string/field_style"
                        android:textSize="12sp"
                        android:lineHeight="16sp"
                        android:letterSpacing="0.04"
                        android:fontFamily="@font/inter_medium"
                        android:textColor="@color/rowin_on_surface_variant" />

                    <EditText
                        android:id="@+id/add_style"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="56dp"
                        android:background="@drawable/bg_field"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:hint="@string/hint_style"
                        android:textColorHint="@color/rowin_outline"
                        android:textSize="14sp"
                        android:fontFamily="@font/inter"
                        android:textColor="@color/rowin_on_surface"
                        android:inputType="text"
                        android:singleLine="true" />
                </LinearLayout>
            </LinearLayout>

            <Space
                android:layout_width="match_parent"
                android:layout_height="16dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginBottom="6dp"
                android:text="@string/field_material"
                android:textSize="12sp"
                android:lineHeight="16sp"
                android:letterSpacing="0.04"
                android:fontFamily="@font/inter_medium"
                android:textColor="@color/rowin_on_surface_variant" />

            <EditText
                android:id="@+id/add_material"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="56dp"
                android:background="@drawable/bg_field"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:hint="@string/hint_material"
                android:textColorHint="@color/rowin_outline"
                android:textSize="14sp"
                android:fontFamily="@font/inter"
                android:textColor="@color/rowin_on_surface"
                android:inputType="text"
                android:singleLine="true" />

            <TextView
                android:id="@+id/add_error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:visibility="gone"
                tools:visibility="visible"
                android:textSize="13sp"
                android:lineHeight="18sp"
                android:fontFamily="@font/inter"
                android:textColor="@color/rowin_error"
                tools:text="Give the item a name first." />

            <Space
                android:layout_width="match_parent"
                android:layout_height="24dp" />
        </LinearLayout>
    </ScrollView>

    <!-- Fixed bottom action bar (per mock) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/rowin_surface">

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/rowin_surface_variant" />

        <Button
            android:id="@+id/add_save"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_margin="20dp"
            android:background="@drawable/bg_button_primary"
            android:stateListAnimator="@null"
            android:text="@string/add_to_closet"
            android:textSize="14sp"
            android:letterSpacing="0.01"
            android:fontFamily="@font/inter_medium"
            android:textColor="@color/rowin_on_primary" />
    </LinearLayout>
</LinearLayout>
