<?xml version="1.0" encoding="utf-8"?>
<!--
    Feature #10 - Outfit Details: name, occasion, season, created date, the
    item breakdown rail, plus Edit Outfit (#12) and Remove Outfit (#13, with
    the confirmation bottom sheet from #18).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/outfit_detail_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/rowin_surface">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <ImageButton
            android:id="@+id/outfit_detail_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_back"
            android:contentDescription="@string/back" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/outfit_details"
            android:textSize="20sp"
            android:lineHeight="26sp"
            android:fontFamily="@font/manrope"
            android:textStyle="bold"
            android:textColor="@color/rowin_primary" />

        <ImageButton
            android:id="@+id/outfit_detail_remove"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_delete"
            android:tint="@color/rowin_error"
            android:contentDescription="@string/remove_outfit" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/outfit_detail_loading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="24dp"
                android:text="@string/loading"
                android:textSize="14sp"
                android:lineHeight="20sp"
                android:fontFamily="@font/inter" />

            <!-- Hero: first item image on green -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:background="@drawable/bg_hero_card">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    xmlns:app="http://schemas.android.com/apk/res-auto">

                    <ImageView
                        android:id="@+id/outfit_hero_image"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:scaleType="centerCrop"
                        android:contentDescription="@string/none"
                        app:layout_constraintDimensionRatio="3:4"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <ImageView
                        android:id="@+id/outfit_hero_placeholder"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:src="@drawable/ic_style_outlined"
                        android:tint="@color/rowin_on_primary_container"
                        android:contentDescription="@string/none"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <TextView
                    android:id="@+id/outfit_hero_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|start"
                    android:layout_margin="12dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:background="@drawable/bg_slot_chip"
                    android:textSize="14sp"
                    android:lineHeight="20sp"
                    android:letterSpacing="0.01"
                    android:fontFamily="@font/inter_medium"
                    android:textColor="@color/rowin_on_surface"
                    tools:text="Spring Office Look" />
            </FrameLayout>

            <!-- Metadata cards -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="20dp"
                android:paddingBottom="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:padding="12dp"
                        android:background="@drawable/bg_meta_card">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <ImageView
                                android:layout_width="14dp"
                                android:layout_height="14dp"
                                android:src="@drawable/ic_calendar"
                                android:tint="@color/rowin_outline"
                                android:contentDescription="@string/none" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="2dp"
                                android:text="@string/season"
                                android:textSize="11sp"
                                android:lineHeight="14sp"
                                android:letterSpacing="0.04"
                                android:fontFamily="@font/inter_medium"
                                android:textColor="@color/rowin_outline" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/outfit_detail_season"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:textSize="14sp"
                            android:lineHeight="20sp"
                            android:fontFamily="@font/inter"
                            android:textColor="@color/rowin_on_surface"
                            tools:text="Spring" />
                    </LinearLayout>

                    <Space
                        android:layout_width="12dp"
                        android:layout_height="1dp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:padding="12dp"
                        android:background="@drawable/bg_meta_card">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <ImageView
                                android:layout_width="14dp"
                                android:layout_height="14dp"
                                android:src="@drawable/ic_style_outlined"
                                android:tint="@color/rowin_outline"
                                android:contentDescription="@string/none" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="2dp"
                                android:text="@string/occasion"
                                android:textSize="11sp"
                                android:lineHeight="14sp"
                                android:letterSpacing="0.04"
                                android:fontFamily="@font/inter_medium"
                                android:textColor="@color/rowin_outline" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/outfit_detail_occasion"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:textSize="14sp"
                            android:lineHeight="20sp"
                            android:fontFamily="@font/inter"
                            android:textColor="@color/rowin_on_surface"
                            tools:text="Casual" />
                    </LinearLayout>
                </LinearLayout>

                <Space
                    android:layout_width="match_parent"
                    android:layout_height="12dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp"
                    android:background="@drawable/bg_meta_card">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:src="@drawable/ic_history"
                            android:tint="@color/rowin_outline"
                            android:contentDescription="@string/none" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="2dp"
                            android:text="@string/created"
                            android:textSize="11sp"
                            android:lineHeight="14sp"
                            android:letterSpacing="0.04"
                            android:fontFamily="@font/inter_medium"
                            android:textColor="@color/rowin_outline" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/outfit_detail_created"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textSize="14sp"
                        android:lineHeight="20sp"
                        android:fontFamily="@font/inter"
                        android:textColor="@color/rowin_on_surface"
                        tools:text="Saturday, October 3rd 2026" />
                </LinearLayout>

                <!-- AI note (hidden when absent) -->
                <LinearLayout
                    android:id="@+id/outfit_detail_ai_note_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="16dp"
                    android:background="@drawable/bg_ai_note"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_auto_awesome"
                        android:tint="@color/rowin_primary"
                        android:contentDescription="@string/none" />

                    <TextView
                        android:id="@+id/outfit_detail_ai_note"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="2dp"
                        android:textSize="13sp"
                        android:lineHeight="18sp"
                        android:fontFamily="@font/inter"
                        android:textColor="@color/rowin_on_surface_variant"
                        tools:text="Generated with Groq AI" />
                </LinearLayout>

                <!-- Outfit breakdown -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:layout_marginBottom="12dp"
                    android:text="@string/outfit_breakdown"
                    android:textSize="16sp"
                    android:lineHeight="22sp"
                    android:fontFamily="@font/manrope"
                    android:textStyle="bold"
                    android:textColor="@color/rowin_primary" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/outfit_breakdown_rail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:clipToPadding="false"
                    android:overScrollMode="never"
                    tools:listitem="@layout/item_breakdown" />

                <Space
                    android:layout_width="match_parent"
                    android:layout_height="28dp" />

                <Button
                    android:id="@+id/outfit_detail_edit"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_button_primary"
                    android:stateListAnimator="@null"
                    android:text="@string/edit_outfit"
                    android:textSize="14sp"
                    android:letterSpacing="0.01"
                    android:fontFamily="@font/inter_medium"
                    android:textColor="@color/rowin_on_primary" />

                <Space
                    android:layout_width="match_parent"
                    android:layout_height="12dp" />

                <Button
                    android:id="@+id/outfit_detail_remove_button"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_button_outlined_danger"
                    android:stateListAnimator="@null"
                    android:text="@string/remove_outfit"
                    android:textSize="14sp"
                    android:letterSpacing="0.01"
                    android:fontFamily="@font/inter_medium"
                    android:textColor="@color/rowin_error" />

                <Space
                    android:layout_width="match_parent"
                    android:layout_height="32dp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
