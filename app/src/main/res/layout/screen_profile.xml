<?xml version="1.0" encoding="utf-8"?>
<!--
    Feature #15 - User Profile - 1:1 with the Stitch profile design: big
    avatar (editable), identity, My Activity stats, Account rows (Edit
    Profile / Saved Outfits / AI Assistant / AI Alerts / App Settings) and
    the Sign Out button (confirmation bottom sheet in code, #18).
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:scrollbars="none"
    android:background="@color/rowin_surface">

    <LinearLayout
        android:id="@+id/profile_root"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Profile header (editable avatar per profile_detail design) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingTop="24dp"
            android:paddingBottom="8dp">

            <FrameLayout
                android:id="@+id/profile_avatar_root"
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:background="@drawable/bg_circle_avatar"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/profile_avatar_image"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:contentDescription="@string/profile_photo" />

                <TextView
                    android:id="@+id/profile_avatar_initial"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:textSize="28sp"
                    android:lineHeight="36sp"
                    android:letterSpacing="-0.02"
                    android:fontFamily="@font/manrope"
                    android:textStyle="bold"
                    android:textColor="@color/rowin_primary"
                    tools:text="E" />
            </FrameLayout>

            <TextView
                android:id="@+id/profile_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:textSize="24sp"
                android:lineHeight="32sp"
                android:letterSpacing="-0.01"
                android:fontFamily="@font/manrope"
                android:textStyle="bold"
                android:textColor="@color/rowin_on_surface"
                tools:text="Edwin Pious" />

            <TextView
                android:id="@+id/profile_email"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textSize="14sp"
                android:lineHeight="20sp"
                android:fontFamily="@font/inter"
                android:textColor="@color/rowin_on_surface_variant"
                tools:text="edwinpious@gmail.com" />
        </LinearLayout>

        <!-- My Activity stats (dynamic) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="16dp"
            android:paddingBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/my_activity"
                android:textSize="12sp"
                android:lineHeight="16sp"
                android:letterSpacing="0.04"
                android:fontFamily="@font/inter_medium"
                android:textColor="@color/rowin_on_surface_variant" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="16dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:background="@drawable/bg_stat_card">

                    <FrameLayout
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_circle_low">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_closet_outlined"
                            android:tint="@color/rowin_primary"
                            android:contentDescription="@string/none" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/profile_stat_items"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:textSize="20sp"
                        android:lineHeight="26sp"
                        android:fontFamily="@font/manrope"
                        android:textStyle="bold"
                        android:textColor="@color/rowin_on_surface"
                        tools:text="12" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/wardrobe_items"
                        android:textSize="14sp"
                        android:lineHeight="20sp"
                        android:fontFamily="@font/inter"
                        android:textColor="@color/rowin_on_surface_variant" />
                </LinearLayout>

                <Space
                    android:layout_width="12dp"
                    android:layout_height="1dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:background="@drawable/bg_stat_card">

                    <FrameLayout
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_circle_low">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_style_outlined"
                            android:tint="@color/rowin_primary"
                            android:contentDescription="@string/none" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/profile_stat_outfits"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:textSize="20sp"
                        android:lineHeight="26sp"
                        android:fontFamily="@font/manrope"
                        android:textStyle="bold"
                        android:textColor="@color/rowin_on_surface"
                        tools:text="3" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/outfits_saved"
                        android:textSize="14sp"
                        android:lineHeight="20sp"
                        android:fontFamily="@font/inter"
                        android:textColor="@color/rowin_on_surface_variant" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Account section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/account"
                android:textSize="12sp"
                android:lineHeight="16sp"
                android:letterSpacing="0.04"
                android:fontFamily="@font/inter_medium"
                android:textColor="@color/rowin_on_surface_variant" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="16dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_account_card">

                <LinearLayout
                    android:id="@+id/profile_row_edit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="16dp"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_person_outlined"
                        android:tint="@color/rowin_secondary"
                        android:contentDescription="@string/none" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:text="@string/edit_profile"
                        android:textSize="16sp"
                        android:lineHeight="24sp"
                        android:fontFamily="@font/inter"
                        android:textColor="@color/rowin_on_surface" />

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_forward"
                        android:tint="@color/rowin_outline_variant"
                        android:contentDescription="@string/none" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/profile_row_saved"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="16dp"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_bookmark"
                        android:tint="@color/rowin_secondary"
                        android:contentDescription="@string/none" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:text="@string/saved_outfits"
                        android:textSize="16sp"
                        android:lineHeight="24sp"
                        android:fontFamily="@font/inter"
                        android:textColor="@color/rowin_on_surface" />

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_forward"
                        android:tint="@color/rowin_outline_variant"
                        android:contentDescription="@string/none" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/profile_row_assistant"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="16dp"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_auto_awesome"
                        android:tint="@color/rowin_secondary"
                        android:contentDescription="@string/none" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:text="@string/ai_assistant"
                        android:textSize="16sp"
                        android:lineHeight="24sp"
                        android:fontFamily="@font/inter"
                        android:textColor="@color/rowin_on_surface" />

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_forward"
                        android:tint="@color/rowin_outline_variant"
                        android:contentDescription="@string/none" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/profile_row_alerts"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="16dp"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_notifications"
                        android:tint="@color/rowin_secondary"
                        android:contentDescription="@string/none" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:text="@string/ai_alerts"
                        android:textSize="16sp"
                        android:lineHeight="24sp"
                        android:fontFamily="@font/inter"
                        android:textColor="@color/rowin_on_surface" />

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_forward"
                        android:tint="@color/rowin_outline_variant"
                        android:contentDescription="@string/none" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/profile_row_settings"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="16dp"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_settings"
                        android:tint="@color/rowin_secondary"
                        android:contentDescription="@string/none" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:text="@string/app_settings"
                        android:textSize="16sp"
                        android:lineHeight="24sp"
                        android:fontFamily="@font/inter"
                        android:textColor="@color/rowin_on_surface" />

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_forward"
                        android:tint="@color/rowin_outline_variant"
                        android:contentDescription="@string/none" />
                </LinearLayout>
            </LinearLayout>

            <Space
                android:layout_width="match_parent"
                android:layout_height="24dp" />

            <Button
                android:id="@+id/profile_sign_out"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@drawable/bg_button_outlined_danger"
                android:stateListAnimator="@null"
                android:text="@string/sign_out"
                android:textSize="14sp"
                android:letterSpacing="0.01"
                android:fontFamily="@font/inter_medium"
                android:textColor="@color/rowin_error" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="32dp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
