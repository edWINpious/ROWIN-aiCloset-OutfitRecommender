<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- App theme: platform Material, no ActionBar (Compose draws everything) -->
    <style name="Theme.Rowinadlproject" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <!-- Splash screen: brand green window + white ROWIN wordmark -->
    <style name="Theme.Rowinadlproject.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/rowin_primary_container</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_logo_rowin</item>
        <item name="windowSplashScreenAnimationDuration">400</item>
        <item name="postSplashScreenTheme">@style/Theme.Rowinadlproject</item>
    </style>
</resources>
