<?xml version="1.0" encoding="utf-8"?>
<!-- Assistant chat bubble: white card with hairline border, 16/16/4/16 corners -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/rowin_surface_container_lowest" />
    <stroke android:width="1dp" android:color="@color/rowin_surface_variant" />
    <corners android:topLeftRadius="16dp" android:topRightRadius="16dp"
        android:bottomLeftRadius="4dp" android:bottomRightRadius="16dp" />
</shape>
