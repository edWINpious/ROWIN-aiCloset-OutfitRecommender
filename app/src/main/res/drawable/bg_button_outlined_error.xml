<?xml version="1.0" encoding="utf-8"?>
<!-- Bordered destructive button (Delete Item / Sign Out confirmations).
     Pale container fill + 1dp red stroke keeps the label legible whatever the
     sheet behind it resolves to, unlike the filled green button it replaces. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/rowin_error_container" />
    <stroke
        android:width="1dp"
        android:color="@color/rowin_error" />
    <corners android:radius="14dp" />
</shape>
