<?xml version="1.0" encoding="utf-8"?>
<!-- ROWIN input field: white surface, outline-variant border, 14dp radius.
     Focus ring (green border) applied via FocusDrawable in code. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/rowin_surface_container_lowest" />
            <stroke android:width="1dp" android:color="@color/rowin_primary_container" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/rowin_surface_container_lowest" />
            <stroke android:width="1dp" android:color="@color/rowin_outline_variant" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</selector>
