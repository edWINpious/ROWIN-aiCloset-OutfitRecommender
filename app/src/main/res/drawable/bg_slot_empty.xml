<?xml version="1.0" encoding="utf-8"?>
<!-- Empty planner slot: surface container + outline-variant border, 14dp -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/rowin_surface_container_low" />
            <stroke android:width="1dp" android:color="@color/rowin_primary_container" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/rowin_surface_container" />
            <stroke android:width="1dp" android:color="@color/rowin_outline_variant" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</selector>
